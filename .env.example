# inkboard settings. Copy this file to .env (never committed) and set what differs for you:
# remove the "#" in front of a setting and change its value; a line that starts with "#" is ignored.
# .env is read from the folder you start inkboard in; real environment variables win over it.
# Every setting is optional; the values shown are the defaults or neutral examples.

# Your tablet's Wi-Fi MAC (on the tablet: cat /sys/class/net/wlan0/address). Without it,
# inkboard never searches your network for the tablet; remembered and listed addresses still work.
# INKBOARD_TABLET_MAC=00:00:5E:00:53:AF

# Wi-Fi addresses to try, in order, after the cable and the remembered address
# (private LAN addresses only, comma-separated, at most 16).
# INKBOARD_WIFI_ADDRESSES=192.168.1.42

# The host entry in ~/.ssh/config: its user, key and known-hosts name.
# INKBOARD_SSH_HOST=remarkable

# The SSH client (default: C:\Windows\System32\OpenSSH\ssh.exe on Windows, ssh elsewhere).
# INKBOARD_SSH_BIN=ssh

# The pen device, the size of its input records and how its axes map onto the page.
# Run `uv run inkboard probe` to measure them on your tablet.
# INKBOARD_PEN_DEVICE=/dev/input/event1
# INKBOARD_EVENT_SIZE=16
# INKBOARD_ORIENTATION=swap_xy,flip_y

# How long points are gathered before they are sent to the page (4-100 ms).
# INKBOARD_BATCH_MS=16

# The page port (1024-65535); the server always binds to 127.0.0.1.
# INKBOARD_PORT=8000
